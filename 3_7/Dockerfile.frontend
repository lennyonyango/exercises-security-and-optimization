FROM node:16-alpine

WORKDIR /usr/src/app

COPY code/example-frontend/ /tmp/src/

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install -g serve \
    && cd /tmp/src \
    && npm install \
    && npm run build \
    && mv build /usr/src/app/build \
    && cd / \
    && rm -rf /tmp/src /root/.npm \
    && adduser -D -H appuser

USER appuser

EXPOSE 5001

CMD ["serve", "-s", "-l", "5001", "build"]