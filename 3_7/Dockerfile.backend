FROM golang:1.16-alpine

WORKDIR /usr/src/app

COPY code/example-backend/ /tmp/src/

RUN cd /tmp/src \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /usr/local/bin/server . \
    && cd / \
    && rm -rf /tmp/src /go/pkg/mod /root/.cache \
    && adduser -D -H appuser

ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001

USER appuser

EXPOSE 8080

CMD ["server"]