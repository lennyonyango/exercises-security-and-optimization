FROM ubuntu:20.04

WORKDIR /usr/src/app

COPY code/example-backend/ /tmp/src/

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://go.dev/dl/go1.16.15.linux-amd64.tar.gz | tar -C /usr/local -xz \
    && cd /tmp/src \
    && CGO_ENABLED=0 /usr/local/go/bin/go build -trimpath -ldflags="-s -w" -o /usr/local/bin/server . \
    && cd / \
    && rm -rf /usr/local/go /tmp/src /root/go /root/.cache \
    && apt-get purge -y --auto-remove curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -M --system appuser

ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001

USER appuser

EXPOSE 8080

CMD ["server"]